# ============================================================
# JD_AdOperation .gitignore
# 原则：登录态、抓包、抓取数据、报告与Excel、截图、本地真实账号配置、临时产物一律不入库
# ============================================================

# ---- 登录态与浏览器持久化 Profile（含 Cookie / localStorage，最高敏感）----
auth/
browser_profile*/
*.har

# ---- 抓取数据与分析产物（含账号/店铺/商品/经营数据，一律不入库）----
data/
docker-data/
docker-auth/
docker-config/

# ---- 本地私有配置（存放真实京准通账户 ID、SKU 成本等）----
jd_roi/local_config.py
config/accounts.json
config/costs.json
config/costs.template.json
config/needed_skus.csv
config/costs_units.json
# 内部对接文档原件（含真实 SKU / 结算价 / 内部地址，不入库；脱敏版是 SKU成本接口对接说明.md）
SKU成本接口对接说明.local.md
.env
.env.*
!.env.example

# ---- 截图 / 图片（页面截图含账号昵称与账户ID，一律不入库）----
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.svg

# ---- 临时 / 调试产物 ----
tmp/
.tmp/
*.log

# ---- 报告与 Excel（内联/存放经营数据：花费、成交、客单价、成本、扣点，一律不入库）----
ad_roi_report*.html
*.xls*
*.bak2
# 例外：脱敏后的空模板可以入库（不含任何真实经营数据）
!config/roi-template.xlsx

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
*.egg-info/

# ---- IDE / 编辑器 ----
.trae/
.idea/
.vscode/
*.swp

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- agent 本地记忆（含真实 SKU / 经营数字，不入库）----
.workbuddy/

# ---- 报表产物（含真实商品别名/经营数据/隐私账号，不入库）----
account_b_plan_review.html
