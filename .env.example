# 复制为 .env 后按需修改
TZ=Asia/Shanghai
JD_WEB_PORT=8000

# 构建镜像时 pip 用的源。国内直连官方源(pypi.org)会超时导致 docker build 失败，
# 国内环境请保留镜像源，或换成 https://mirrors.cloud.tencent.com/pypi/simple/ 等。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 每天几点抓（本地时区）。0:05 是为了等前一天商智数据结算
JD_SCHEDULE_HOUR=0
JD_SCHEDULE_MINUTE=5

# 每晚回刷最近多少天（京准通 15 天归因，建议 >= 15）
JD_REFRESH_DAYS=15

# 容器停机后最多补多少天（防止一次补一年）
JD_MAX_BACKFILL_DAYS=120

# 启动时若发现昨天没数据就自动补跑
JD_RUN_ON_START=1
JD_ENABLE_SCHEDULER=1

# 只处理其中几个账号，逗号分隔（留空=全部）。被排除的账号既不抓取也不进报表
JD_SCOPE=
