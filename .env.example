# 复制为 .env 后按需修改
TZ=Asia/Shanghai
JD_WEB_PORT=8000

# 构建镜像时 pip 用的源。国内直连官方源(pypi.org)会超时导致 docker build 失败，
# 国内环境请保留镜像源，或换成 https://mirrors.cloud.tencent.com/pypi/simple/ 等。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 每天几点抓（本地时区）。1:00 是为了等前一天商智数据结算
JD_SCHEDULE_HOUR=1
JD_SCHEDULE_MINUTE=0
# 在基准时间上随机浮动 ±N 分钟（默认 30），避免每天同一秒被抓取风控识别为机器
JD_SCHEDULE_JITTER=30

# 每晚回刷最近多少天（京准通 15 天归因，建议 >= 15）
JD_REFRESH_DAYS=15

# 容器停机后最多补多少天（防止一次补一年）
JD_MAX_BACKFILL_DAYS=120

# 启动时若发现昨天没数据就自动补跑
JD_RUN_ON_START=1
JD_ENABLE_SCHEDULER=1

# 登录态保活：京准通的会话凭据 sdtoken 只有约 30 分钟，无人操作的后台进程必须定时「用一下」
# 才不会被踢下线（京麦客户端就是这么保活的）。开启后 Web 服务常驻时会按下面的间隔自动续期。
JD_KEEPALIVE=1
# 续期间隔（秒），必须小于 30 分钟；默认 20 分钟
JD_KEEPALIVE_INTERVAL=1200
# 每次随机抖动的秒数上限，避免固定节奏被风控
JD_KEEPALIVE_JITTER=120
# 保活时依次访问的页面（逗号分隔，留空=京准通首页）。
# 模仿京麦的做法：打开**真实业务页**并停留，页面前端脚本会自动发出
# sso.jd.com/sso/rac（续期，带 SET-COOKIE）、blackhole bypass（风控）、
# sgm-w/h5（埋点）等心跳，比只访问首页更接近真人操作。
# 例：JD_KEEPALIVE_PAGES=https://jzt.jd.com/msa/#/list/tab/plan?objective=overview
JD_KEEPALIVE_PAGES=
# 每个页面停留毫秒数（等前端把心跳发完）
JD_KEEPALIVE_DWELL=8000
# 保活成功时顺带导出 storage_state 快照（默认关；Profile 已是权威源，无需每次写盘）
JD_KEEPALIVE_EXPORT_STATE=0

# 只处理其中几个账号，逗号分隔（留空=全部）。被排除的账号既不抓取也不进报表
JD_SCOPE=

# 供货方 SKU 真实成本接口（算每个 SKU 自己的保本线；不填就用全店 Excel 口径）
# 真实地址与 Token 只写 .env，不要提交
JD_COSTS_URL=http://<供货方内网地址>/api/open/sku-costs
JD_COSTS_TOKEN=
# 拉取超时/缓存时长（秒）；6 小时内的重复分析直接用本地缓存 data/costs_cache.json
JD_COSTS_TIMEOUT=20
JD_COSTS_TTL=21600
